NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Server/Edge only. Never expose these with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
CRON_SHARED_SECRET=
EMAIL_WEBHOOK_URL=
EMAIL_WEBHOOK_SECRET=

# Used only by the app's circle-invitation webhook. Supabase Auth OTP emails
# require Custom SMTP to be configured separately in the Supabase Dashboard.
# Keep these server-only.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
# Optional display name/address override; defaults to NestList <SMTP_USER>.
EMAIL_FROM_ADDRESS=NestList <noreply@example.com>
